node_modules/
dist/
.env
.env.*
*.key
*.pem
# [session 60] `config/discovered.json` is NO LONGER ignored. It is game-global —
# dungeon 5, maxRoom 16, endpoints and request shapes are the same for everyone,
# so shipping it saves every new user a probe.ts run. The per-account half it
# used to carry (ROM NFT token ids and the 37-ROM enumeration) moved to
# data/roms.json, which `data/` below still ignores. Pinned by
# tests/discoveredShipsClean.test.ts, which fails if an identifier returns.
data/
logs/
# [session 59] Everything a named --profile writes: another account's ledgers,
# logs, captures and budgets. `data/` and `logs/` above already match at any
# depth, but `profiles/<name>/fixtures/` and `.../config/` did not — a second
# account's captured game states would have been committed to this public repo.
# Pinned by tests/profile.test.ts.
profiles/
fixtures/**/*.har
fixtures/**/*.harx
# Raw dumps carry the real wallet address. The redacted copies one level up are
# the committed corpus — see scripts/probe.ts and scripts/battleWatch.ts.
# Must cover every raw/ dir, not just probe's: battleWatch writes
# fixtures/dungeon-runs/raw/ and staged 104 address-bearing lines when this
# rule was probe-specific.
fixtures/**/raw/
.DS_Store
.claude/settings.local.json
